# Robopoker TypeScript SDK Configuration
#
# Copy this file to .env and fill in your values.

# Solana RPC endpoints
# For production use Helius: https://devnet.helius-rpc.com?api-key=YOUR_KEY
# Sign up at https://www.helius.dev/ for a free API key
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
