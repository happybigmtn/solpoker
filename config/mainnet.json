{
  "$schema": "./schema.json",
  "environment": "mainnet",
  "description": "Solana Mainnet-Beta configuration for production",
  "network": {
    "rpcUrl": "https://api.mainnet-beta.solana.com",
    "wsUrl": "wss://api.mainnet-beta.solana.com",
    "commitment": "finalized",
    "skipPreflight": false
  },
  "programs": {
    "entropy": {
      "programId": null,
      "description": "MUST be set before mainnet deployment"
    },
    "poker": {
      "programId": null,
      "description": "MUST be set before mainnet deployment"
    }
  },
  "tokens": {
    "crispsMint": null,
    "decimals": 6,
    "description": "CRISPS Token-2022 mint - MUST be set for mainnet"
  },
  "parameters": {
    "entropyConfig": {
      "minBond": 1000000000,
      "revealWindowSlots": 150,
      "slashBasisPoints": 5000,
      "description": "Mainnet: 1 SOL minimum bond"
    },
    "pokerConfig": {
      "minBuyIn": 10000000,
      "maxBuyIn": 10000000000,
      "actionTimeoutSlots": 120,
      "minPlayers": 2,
      "rakeBps": 250,
      "description": "Mainnet: 2 minute action timeout, 2.5% rake"
    }
  },
  "features": {
    "allowTestMints": false,
    "allowUnlimitedAirdrop": false,
    "debugLogging": false
  },
  "validation": {
    "requiredFields": [
      "network.rpcUrl",
      "network.wsUrl",
      "programs.entropy.programId",
      "programs.poker.programId",
      "tokens.crispsMint",
      "parameters.entropyConfig.minBond"
    ],
    "environmentMustMatch": "mainnet"
  }
}
